# DD Empire Studio — environment (optional)
# Copy to .env.local and fill in to preconfigure. All are optional; the app also
# lets you enter these in Settings at runtime. Anon/publishable keys are safe to expose
# (protected by row-level security) — but never put a SERVICE ROLE key here.

# Supabase cloud sync (optional)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Veo 3 via a hosted serverless proxy instead of a per-user key (optional)
# VITE_VEO_PROXY=/api/veo

# Enforce the license gate for a paid build (optional)
# VITE_REQUIRE_LICENSE=true
